#NEXUS

BEGIN TAXA;
    DIMENSIONS NTAX=10;
    TAXLABELS
        A
        B
        C
        D
        E
        F
        G
        H
        I
        J
  ;
END;

BEGIN CHARACTERS;
    DIMENSIONS NCHAR=1000000;
    FORMAT DATATYPE=DNA GAP=- MISSING=? MATCHCHAR=.;
    MATRIX
        A    
        B    
        C    
        D    
        E    
        F    
        G    
        H    
        I    
        J    
    ;
END;


BEGIN SETS;
    charset locus000 = 1-320000;
    charset locus001 = 320001-400000;
    charset locus002 = 400001-880000;
    charset locus003 = 880001-1000000;
END;


